# Copy this file to ~/.worktrail/provider-model-catalog.yaml.
# Override that path with WORKTRAIL_PROVIDER_MODEL_CATALOG_FILE.
#
# Providers and models are tried top-to-bottom. Reorder list items to change
# preference; keep providers and models as lists so ordering is unambiguous.
# This file expresses operator intent. Discovery writes observed.* metadata
# separately and must not reorder or add candidates.
version: 1
providers:
  - name: claude
    source: cli
    enabled: true
    models:
      - name: sonnet
        cost: paid
        capabilities: [tools, coding, long-context]
        purposes: [implement, review]
        enabled: true
        observed: {}
      - name: haiku
        cost: paid-low
        capabilities: [tools, coding]
        purposes: [classify, cleanup]
        enabled: true
        observed: {}

  - name: codex
    source: cli
    enabled: true
    models:
      - name: gpt-5.4-mini
        cost: paid-low
        capabilities: [tools, coding]
        purposes: [implement, classify]
        enabled: true
        observed: {}

  - name: opencode
    source: cli
    enabled: true
    models:
      - name: opencode/deepseek-v4-flash-free
        cost: free
        capabilities: [tools, low-context]
        purposes: [classify, trivia]
        enabled: true
        observed: {}
