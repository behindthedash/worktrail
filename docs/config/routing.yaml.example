# Copy this file to ~/.worktrail/routing.yaml (the machine-wide default) or
# inline its `routing:`-nested keys directly under a repo's own
# docs/specs/go-policy.yaml `routing:` block. Override the machine-wide
# path with WORKTRAIL_ROUTING_FILE. A non-empty repo-local `routing:` block
# is used in full instead of this file -- it is not merged per-key with the
# machine-wide file (see policy.py's _resolve_routing()).
#
# This is the target-selector routing schema (routing-target-selector):
# everything a spawn needs -- which harness to run, which account pool it
# bills against, and which model/effort to ask for at a given tier -- lives
# here, under routing.*. All sections below are optional and independent --
# set only the ones this machine/repo needs; every unset section falls
# through to worktrail's built-in defaults with no behavior change
# (resolve_routing()/select_cell()/drain.py's own fallbacks).
#
# A harness literal anywhere below must be one of: claude, codex, opencode
# (see policy.py SUPPORTED_AGENTS). A target's pool must be one of:
# subscription, free, api. "api" without api_opt_in: true is loaded but
# skipped with a warning at selection time (AC-005) -- it bypasses the
# per-subscription capacity system entirely, so it never fires silently.

# routing.targets: an ORDERED mapping of execution target -> {harness, pool,
# api_opt_in?, auth?}. Order is preference: select_cell() walks targets in
# this file order (unless a role's `prefer` moves one to the front) and
# serves the first one with a cell in the requested tier row that isn't
# capacity-gated. Two targets may share a harness (e.g. a subscription lane
# and an API lane on the same CLI) -- names are free-form and are exactly
# the keys the `tiers` rows below use.
#
# Two targets on one harness and one pool is also how you express an
# INTRA-HARNESS MODEL LADDER -- "try model A on this CLI, then model B on
# the same CLI, before leaving the harness at all". A tier row holds at
# most one cell per target (`tiers.<row>.<target>`), so a single target
# cannot list two models for the same row; declaring a second target is
# what gives the row a second rung. Because the capacity cache is keyed
# `provider_key(target, model)`, each rung is an independently gated cell,
# so a per-MODEL quota cap (a subscription that meters one model separately
# from the rest of the plan) gates only its own rung and select_cell() falls
# through to the next one. There is no quota arithmetic and no fallback
# code anywhere in this: the ladder is target file order.
#
#   targets:
#     claude-premium:      # rung 1 -- metered separately by the provider
#       harness: claude
#       pool: subscription
#     claude-sub:          # rung 2 -- same CLI, same plan, different model
#       harness: claude
#       pool: subscription
#   tiers:
#     t2-build:
#       claude-premium: {model: <metered-model>, effort: low}
#       claude-sub:     {model: <plan-model>,    effort: low}
#
# Order the rungs deliberately: the FIRST target in this file that has a
# cell in the row and isn't gated wins, so put the constrained/preferred
# model first and the always-available one after it.
targets:
  claude-sub:
    harness: claude
    pool: subscription
  codex-sub:
    harness: codex
    pool: subscription
  opencode-free:
    harness: opencode
    pool: free
  # An API/OpenRouter lane is excluded from selection unless it opts in
  # explicitly -- it bypasses the per-subscription capacity system entirely,
  # so a silent fallback to one would mask capacity/quota assumptions the
  # rest of the routing system makes:
  # claude-api:
  #   harness: claude
  #   pool: api
  #   api_opt_in: true
  #   auth:
  #     env: ANTHROPIC_API_KEY

# routing.default_tier: the tier row consulted whenever nothing more
# specific (a task's own tier, a role, or a purpose) pins one -- replaces
# the retired per-agent default_model.
default_tier: t2-build

# routing.tiers: rows of model/effort cells keyed by declared target name --
# `tiers.<row>.<target> = {model, effort?}`. A target with no cell in a row
# cannot serve that tier and is skipped (a missing cell means "cannot
# serve", not "use some default"). Rows are named freely; t1-deep..t4-trivia
# are the shipped starter names, roughly ordered most- to least-capable.
tiers:
  t1-deep:
    claude-sub:
      model: opus
      effort: xhigh
    codex-sub:
      model: gpt-5.6-sol
      effort: xhigh
    opencode-free:
      model: opencode/claude-opus-5

  t2-build:
    claude-sub:
      model: sonnet
      effort: medium
    codex-sub:
      model: gpt-5.6-terra
      effort: medium
    opencode-free:
      model: opencode/x-preview-f-free

  t3-bulk:
    claude-sub:
      model: haiku
      effort: medium
    codex-sub:
      model: gpt-5.6-terra
      effort: low
    opencode-free:
      model: opencode/x-preview-f-free

  t4-trivia:
    claude-sub:
      model: haiku
      effort: low
    codex-sub:
      model: gpt-5.6-luna
      effort: minimal
    opencode-free:
      model: opencode/x-preview-f-free

# routing.purposes (was routing.purpose_tiers): maps a task's `purpose`
# frontmatter value (set by compile.py's inference pass, or by hand) to a
# `tiers` row, so a task routes on what it is -- architecture design,
# frontend/backend implementation work, exploratory spikes, bulk
# categorization -- rather than a human-assigned `complexity` label.
# `tier_for()` consults this ahead of `complexity`; a task with no
# matching/no `purpose` value falls through to `complexity`-keyed tiers,
# unaffected. The keys on the left are this operator's own vocabulary --
# rename/add/remove freely.
purposes:
  architecture-design: t1-deep
  security-review: t1-deep
  frontend: t2-build
  backend: t2-build
  design: t2-build
  explore: t2-build
  categorize: t3-bulk
  bulk-mechanical: t3-bulk
  trivial: t4-trivia

# routing.roles: resolve one role (e.g. an independent review pass) to a
# tier row, an optional preferred target within that row, and whether the
# selector should prefer to avoid the implementer's own harness. For
# review/resolve/ci-fix/assembly-resolve this is the *only* override that
# can beat the run default (independent-reviewer guarantee) -- a per-task
# `tier` field or `purposes` match is never consulted for those roles.
# `independent: true` is a soft preference, never a reason to fail: a
# same-harness reviewer is the last resort when nothing else is healthy,
# and the run record names which cell actually served.
roles:
  review:
    tier: t1-deep
    prefer: codex-sub
    independent: true

# routing.drain: machine-wide defaults for `worktrail-drain` (unattended
# queue draining). Provider/pool preference now lives entirely in
# `targets`' file order plus `default_tier` above -- there is no separate
# drain-specific agent or fallback chain to configure.
drain:
  max_workers: 2
